/*Problem Statement:
Implement a hash table using quadratic probing with formula:

h(k, i) = (h(k) + i*i) % m

Input Format:
- First line contains table size m
- Second line contains number of operations q
- Next q lines contain operations:
  INSERT x
  SEARCH x

Output Format:
- Print result of SEARCH operations

Example:
Input:
7
4
INSERT 49
INSERT 56
SEARCH 49
SEARCH 15

Output:
FOUND
NOT FOUND*/

#include <stdio.h>
#include <string.h>

#define EMPTY -1

int main() {
    int m, q;
    scanf("%d", &m);
    scanf("%d", &q);

    int table[m];

    for (int i = 0; i < m; i++)
        table[i] = EMPTY;

    while (q--) {
        char op[10];
        int key;
        scanf("%s %d", op, &key);

        int h = key % m;

        if (strcmp(op, "INSERT") == 0) {
            int i = 0;
            int pos;

            while (i < m) {
                pos = (h + i * i) % m;

                if (table[pos] == EMPTY) {
                    table[pos] = key;
                    break;
                }
                i++;
            }
        }
        else if (strcmp(op, "SEARCH") == 0) {
            int i = 0;
            int pos, found = 0;

            while (i < m) {
                pos = (h + i * i) % m;

                if (table[pos] == EMPTY)
                    break;

                if (table[pos] == key) {
                    found = 1;
                    break;
                }
                i++;
            }

            if (found)
                printf("FOUND\n");
            else
                printf("NOT FOUND\n");
        }
    }

    return 0;
}
