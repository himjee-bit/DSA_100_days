/*Problem Statement:
Given intervals, merge all overlapping ones.

Input Format:
- First line contains integer n
- Next n lines contain start and end times

Output Format:
- Print merged intervals

Example:
Input:
4
1 3
2 6
8 10
15 18

Output:
1 6
8 10
15 18*/

#include <stdio.h>

void swap(int *a, int *b) {
    int t = *a;
    *a = *b;
    *b = t;
}

void sortIntervals(int start[], int end[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (start[j] > start[j + 1]) {
                swap(&start[j], &start[j + 1]);
                swap(&end[j], &end[j + 1]);
            }
        }
    }
}

int main() {
    int n;
    scanf("%d", &n);

    int start[n], end[n];

    for (int i = 0; i < n; i++)
        scanf("%d %d", &start[i], &end[i]);

    sortIntervals(start, end, n);

    int currStart = start[0];
    int currEnd = end[0];

    for (int i = 1; i < n; i++) {
        if (start[i] <= currEnd) {
            if (end[i] > currEnd)
                currEnd = end[i];
        } else {
            printf("%d %d\n", currStart, currEnd);
            currStart = start[i];
            currEnd = end[i];
        }
    }

    printf("%d %d", currStart, currEnd);

    return 0;
}
