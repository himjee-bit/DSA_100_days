/*Problem Statement:
Using DFS and parent tracking, detect if an undirected graph has a cycle.

Input Format:
- First line contains n (vertices)
- Second line contains m (edges)
- Next m lines contain pairs (u, v)

Output Format:
- Print YES if cycle exists, otherwise NO

Example:
Input:
4
4
0 1
1 2
2 3
3 1

Output:
YES*/

#include <stdio.h>
#include <stdlib.h>

/* List Node */
typedef struct Node {
    int data;
    struct Node* next;
} Node;

Node* createNode(int x) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->data = x;
    node->next = NULL;
    return node;
}

void addEdge(Node* adj[], int u, int v) {
    Node* node = createNode(v);
    node->next = adj[u];
    adj[u] = node;

    node = createNode(u);
    node->next = adj[v];
    adj[v] = node;
}

int dfs(Node* adj[], int visited[], int v, int parent) {
    visited[v] = 1;

    Node* temp = adj[v];
    while (temp) {
        int u = temp->data;

        if (!visited[u]) {
            if (dfs(adj, visited, u, v))
                return 1;
        }
        else if (u != parent) {
            return 1;
        }

        temp = temp->next;
    }

    return 0;
}

int hasCycle(Node* adj[], int n) {
    int visited[n];
    for (int i = 0; i < n; i++)
        visited[i] = 0;

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            if (dfs(adj, visited, i, -1))
                return 1;
        }
    }

    return 0;
}

int main() {
    int n, m;
    scanf("%d", &n);
    scanf("%d", &m);

    Node* adj[n];
    for (int i = 0; i < n; i++)
        adj[i] = NULL;

    for (int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        addEdge(adj, u, v);
    }

    if (hasCycle(adj, n))
        printf("YES");
    else
        printf("NO");

    return 0;
}
