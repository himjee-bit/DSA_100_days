/*Problem Statement:
Find the integer square root of a given non-negative integer using Binary Search.
The integer square root is the greatest integer whose square is <= n.

Input Format:
- First line contains integer n

Output Format:
- Print the integer square root

Example:
Input:
64

Output:
8*/

#include <stdio.h>

int main() {
    long long n;
    scanf("%lld", &n);

    long long low = 0, high = n, ans = 0;

    while (low <= high) {
        long long mid = (low + high) / 2;

        if (mid * mid <= n) {
            ans = mid;
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    printf("%lld", ans);

    return 0;
}
