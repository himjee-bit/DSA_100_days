/*Problem Statement:
Compute shortest path from source and detect negative weight cycles using Bellman-Ford.

Input Format:
- First line contains n (vertices)
- Second line contains m (edges)
- Next m lines contain (u, v, w)
- Last line contains source vertex s

Output Format:
- Print shortest distances from source
- If negative cycle exists, print "NEGATIVE CYCLE"

Example:
Input:
5
8
0 1 -1
0 2 4
1 2 3
1 3 2
1 4 2
3 2 5
3 1 1
4 3 -3
0

Output:
0 -1 2 -2 1*/

#include <stdio.h>
#include <stdlib.h>

#define INF 1000000000

/* Edge structure */
typedef struct Edge {
    int u, v, w;
} Edge;

int main() {
    int n, m;
    scanf("%d", &n);
    scanf("%d", &m);

    Edge edges[m];

    for (int i = 0; i < m; i++)
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].w);

    int s;
    scanf("%d", &s);

    int dist[n];

    for (int i = 0; i < n; i++)
        dist[i] = INF;

    dist[s] = 0;

    for (int i = 1; i <= n - 1; i++) {
        for (int j = 0; j < m; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;

            if (dist[u] != INF && dist[u] + w < dist[v])
                dist[v] = dist[u] + w;
        }
    }

    for (int j = 0; j < m; j++) {
        int u = edges[j].u;
        int v = edges[j].v;
        int w = edges[j].w;

        if (dist[u] != INF && dist[u] + w < dist[v]) {
            printf("NEGATIVE CYCLE");
            return 0;
        }
    }

    for (int i = 0; i < n; i++)
        printf("%d ", dist[i]);

    return 0;
}
