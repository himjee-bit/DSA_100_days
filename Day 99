/*Problem Statement:
Given a target distance and cars’ positions & speeds, compute the number of car fleets.

Input Format:
- First line contains integer n
- Second line contains n space-separated positions
- Third line contains n space-separated speeds
- Fourth line contains target distance

Output Format:
- Print number of car fleets

Example:
Input:
5
10 8 0 5 3
2 4 1 1 3
12

Output:
3*/

#include <stdio.h>

void swap(float *a, float *b) {
    float t = *a;
    *a = *b;
    *b = t;
}

void sort(int pos[], int speed[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (pos[j] < pos[j + 1]) {
                int tp = pos[j];
                pos[j] = pos[j + 1];
                pos[j + 1] = tp;

                int ts = speed[j];
                speed[j] = speed[j + 1];
                speed[j + 1] = ts;
            }
        }
    }
}

int main() {
    int n;
    scanf("%d", &n);

    int pos[n], speed[n];

    for (int i = 0; i < n; i++)
        scanf("%d", &pos[i]);

    for (int i = 0; i < n; i++)
        scanf("%d", &speed[i]);

    int target;
    scanf("%d", &target);

    sort(pos, speed, n);

    float time[n];

    for (int i = 0; i < n; i++)
        time[i] = (float)(target - pos[i]) / speed[i];

    int fleets = 0;
    float curr = 0;

    for (int i = 0; i < n; i++) {
        if (time[i] > curr) {
            fleets++;
            curr = time[i];
        }
    }

    printf("%d", fleets);

    return 0;
}
