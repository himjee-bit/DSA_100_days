/*Problem Statement:
Check whether a given binary tree satisfies the Min-Heap property.

Input Format:
- First line contains integer N
- Second line contains level-order traversal

Output Format:
- Print YES if valid Min-Heap, otherwise NO

Example:
Input:
7
1 3 5 7 9 8 10

Output:
YES*/

#include <stdio.h>
#include <stdlib.h>

/* Tree Node */
typedef struct Node {
    int data;
    struct Node* left;
    struct Node* right;
} Node;

/* Queue Node */
typedef struct QNode {
    Node* data;
    struct QNode* next;
} QNode;

/* Queue structure */
typedef struct Queue {
    QNode* front;
    QNode* rear;
} Queue;

Node* createNode(int x) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->data = x;
    node->left = node->right = NULL;
    return node;
}

Queue* createQueue() {
    Queue* q = (Queue*)malloc(sizeof(Queue));
    q->front = q->rear = NULL;
    return q;
}

void enqueue(Queue* q, Node* x) {
    QNode* node = (QNode*)malloc(sizeof(QNode));
    node->data = x;
    node->next = NULL;

    if (q->rear == NULL) {
        q->front = q->rear = node;
        return;
    }
    q->rear->next = node;
    q->rear = node;
}

Node* dequeue(Queue* q) {
    if (q->front == NULL)
        return NULL;

    QNode* temp = q->front;
    Node* val = temp->data;
    q->front = q->front->next;

    if (q->front == NULL)
        q->rear = NULL;

    free(temp);
    return val;
}

Node* buildTree(int arr[], int n) {
    if (n == 0)
        return NULL;

    Queue* q = createQueue();
    Node* root = createNode(arr[0]);
    enqueue(q, root);

    int i = 1;

    while (i < n) {
        Node* current = dequeue(q);

        if (i < n) {
            current->left = createNode(arr[i]);
            enqueue(q, current->left);
            i++;
        }

        if (i < n) {
            current->right = createNode(arr[i]);
            enqueue(q, current->right);
            i++;
        }
    }

    return root;
}

int isMinHeap(Node* root) {
    if (root == NULL)
        return 1;

    if (root->left) {
        if (root->data > root->left->data)
            return 0;
    }

    if (root->right) {
        if (root->data > root->right->data)
            return 0;
    }

    return isMinHeap(root->left) && isMinHeap(root->right);
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    Node* root = buildTree(arr, n);

    if (isMinHeap(root))
        printf("YES");
    else
        printf("NO");

    return 0;
}
