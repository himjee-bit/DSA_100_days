/*Problem Statement:
Given n real numbers in [0,1), sort using Bucket Sort.

Input Format:
- First line contains integer n
- Second line contains n space-separated real numbers in [0,1)

Output Format:
- Print the sorted array

Example:
Input:
5
0.78 0.17 0.39 0.26 0.72

Output:
0.17 0.26 0.39 0.72 0.78*/

#include <stdio.h>
#include <stdlib.h>

/* List Node */
typedef struct Node {
    float data;
    struct Node* next;
} Node;

Node* createNode(float x) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->data = x;
    node->next = NULL;
    return node;
}

void sortedInsert(Node** head, float x) {
    Node* node = createNode(x);

    if (*head == NULL || (*head)->data >= x) {
        node->next = *head;
        *head = node;
        return;
    }

    Node* curr = *head;
    while (curr->next && curr->next->data < x)
        curr = curr->next;

    node->next = curr->next;
    curr->next = node;
}

int main() {
    int n;
    scanf("%d", &n);

    float arr[n];

    for (int i = 0; i < n; i++)
        scanf("%f", &arr[i]);

    Node* buckets[n];
    for (int i = 0; i < n; i++)
        buckets[i] = NULL;

    for (int i = 0; i < n; i++) {
        int idx = n * arr[i];
        sortedInsert(&buckets[idx], arr[i]);
    }

    for (int i = 0; i < n; i++) {
        Node* temp = buckets[i];
        while (temp) {
            printf("%.2f ", temp->data);
            temp = temp->next;
        }
    }

    return 0;
}
