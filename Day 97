/*Problem Statement:
Given meeting intervals, find minimum number of rooms required.

Input Format:
- First line contains integer n
- Next n lines contain start and end times

Output Format:
- Print minimum number of rooms required

Example:
Input:
3
0 30
5 10
15 20

Output:
2*/

#include <stdio.h>

void swap(int *a, int *b) {
    int t = *a;
    *a = *b;
    *b = t;
}

void sortIntervals(int start[], int end[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (start[j] > start[j + 1]) {
                swap(&start[j], &start[j + 1]);
                swap(&end[j], &end[j + 1]);
            }
        }
    }
}

void heapifyUp(int heap[], int i) {
    while (i > 0 && heap[(i - 1) / 2] > heap[i]) {
        swap(&heap[(i - 1) / 2], &heap[i]);
        i = (i - 1) / 2;
    }
}

void heapifyDown(int heap[], int size, int i) {
    int smallest = i;

    while (1) {
        int left = 2 * i + 1;
        int right = 2 * i + 2;

        if (left < size && heap[left] < heap[smallest])
            smallest = left;
        if (right < size && heap[right] < heap[smallest])
            smallest = right;

        if (smallest != i) {
            swap(&heap[i], &heap[smallest]);
            i = smallest;
        } else
            break;
    }
}

void push(int heap[], int *size, int val) {
    heap[*size] = val;
    heapifyUp(heap, *size);
    (*size)++;
}

int pop(int heap[], int *size) {
    int val = heap[0];
    heap[0] = heap[*size - 1];
    (*size)--;
    heapifyDown(heap, *size, 0);
    return val;
}

int main() {
    int n;
    scanf("%d", &n);

    int start[n], end[n];

    for (int i = 0; i < n; i++)
        scanf("%d %d", &start[i], &end[i]);

    sortIntervals(start, end, n);

    int heap[n];
    int size = 0;

    push(heap, &size, end[0]);

    for (int i = 1; i < n; i++) {
        if (start[i] >= heap[0])
            pop(heap, &size);

        push(heap, &size, end[i]);
    }

    printf("%d", size);

    return 0;
}
