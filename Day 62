/*Problem Statement:
Build a graph with adjacency list representation using linked lists.

Input Format:
- First line contains n (vertices)
- Second line contains m (edges)
- Next m lines contain pairs (u, v)

Output Format:
- Print adjacency list for each vertex

Example:
Input:
4
3
0 1
1 2
2 3

Output:
0: 1
1: 0 2
2: 1 3
3: 2*/

#include <stdio.h>
#include <stdlib.h>

/* List Node */
typedef struct Node {
    int data;
    struct Node* next;
} Node;

Node* createNode(int x) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->data = x;
    node->next = NULL;
    return node;
}

void addEdge(Node* adj[], int u, int v) {
    Node* node = createNode(v);
    node->next = adj[u];
    adj[u] = node;

    node = createNode(u);
    node->next = adj[v];
    adj[v] = node;
}

int main() {
    int n, m;
    scanf("%d", &n);
    scanf("%d", &m);

    Node* adj[n];

    for (int i = 0; i < n; i++)
        adj[i] = NULL;

    for (int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        addEdge(adj, u, v);
    }

    for (int i = 0; i < n; i++) {
        printf("%d: ", i);
        Node* temp = adj[i];
        while (temp) {
            printf("%d ", temp->data);
            temp = temp->next;
        }
        printf("\n");
    }

    return 0;
}
