/*Problem Statement:
Perform zigzag (spiral) level order traversal of a binary tree. Alternate levels should be traversed left-to-right and right-to-left.

Input Format:
- First line contains integer N
- Second line contains level-order traversal (-1 indicates NULL)

Output Format:
- Print traversal in zigzag order

Example:
Input:
7
1 2 3 4 5 6 7

Output:
1 3 2 4 5 6 7*/

#include <stdio.h>
#include <stdlib.h>

/* Tree Node */
typedef struct Node {
    int data;
    struct Node* left;
    struct Node* right;
} Node;

/* Queue Node */
typedef struct QNode {
    Node* data;
    struct QNode* next;
} QNode;

/* Queue structure */
typedef struct Queue {
    QNode* front;
    QNode* rear;
} Queue;

Node* createNode(int x) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->data = x;
    node->left = node->right = NULL;
    return node;
}

Queue* createQueue() {
    Queue* q = (Queue*)malloc(sizeof(Queue));
    q->front = q->rear = NULL;
    return q;
}

void enqueue(Queue* q, Node* x) {
    QNode* node = (QNode*)malloc(sizeof(QNode));
    node->data = x;
    node->next = NULL;

    if (q->rear == NULL) {
        q->front = q->rear = node;
        return;
    }
    q->rear->next = node;
    q->rear = node;
}

Node* dequeue(Queue* q) {
    if (q->front == NULL)
        return NULL;

    QNode* temp = q->front;
    Node* val = temp->data;
    q->front = q->front->next;

    if (q->front == NULL)
        q->rear = NULL;

    free(temp);
    return val;
}

Node* buildTree(int arr[], int n) {
    if (n == 0 || arr[0] == -1)
        return NULL;

    Queue* q = createQueue();
    Node* root = createNode(arr[0]);
    enqueue(q, root);

    int i = 1;

    while (i < n) {
        Node* current = dequeue(q);

        if (arr[i] != -1) {
            current->left = createNode(arr[i]);
            enqueue(q, current->left);
        }
        i++;

        if (i < n && arr[i] != -1) {
            current->right = createNode(arr[i]);
            enqueue(q, current->right);
        }
        i++;
    }

    return root;
}

void zigzag(Node* root) {
    if (root == NULL)
        return;

    Queue* q = createQueue();
    enqueue(q, root);

    int leftToRight = 1;

    while (q->front != NULL) {
        int size = 0;
        QNode* temp = q->front;
        while (temp) {
            size++;
            temp = temp->next;
        }

        int arr[size];
        for (int i = 0; i < size; i++) {
            Node* curr = dequeue(q);

            int index = leftToRight ? i : (size - 1 - i);
            arr[index] = curr->data;

            if (curr->left)
                enqueue(q, curr->left);

            if (curr->right)
                enqueue(q, curr->right);
        }

        for (int i = 0; i < size; i++)
            printf("%d ", arr[i]);

        leftToRight = !leftToRight;
    }
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    Node* root = buildTree(arr, n);

    zigzag(root);

    return 0;
}
