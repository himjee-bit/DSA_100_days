/*Problem Statement:
Given a binary tree, print its vertical order traversal. Nodes that lie on the same vertical line should be printed together from top to bottom and from left to right.

Input Format:
- First line contains integer N (number of nodes)
- Second line contains N space-separated integers representing level-order traversal (-1 indicates NULL)

Output Format:
- Print nodes column by column from leftmost to rightmost vertical line

Example:
Input:
7
1 2 3 4 5 6 7

Output:
4
2
1 5 6
3
7*/

#include <stdio.h>
#include <stdlib.h>

/* Tree Node */
typedef struct Node {
    int data;
    struct Node* left;
    struct Node* right;
} Node;

/* Queue Node (for tree + horizontal distance) */
typedef struct QNode {
    Node* node;
    int hd;
    struct QNode* next;
} QNode;

/* Queue structure */
typedef struct Queue {
    QNode* front;
    QNode* rear;
} Queue;

/* List for vertical columns */
typedef struct VNode {
    int data;
    struct VNode* next;
} VNode;

Node* createNode(int x) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->data = x;
    node->left = node->right = NULL;
    return node;
}

Queue* createQueue() {
    Queue* q = (Queue*)malloc(sizeof(Queue));
    q->front = q->rear = NULL;
    return q;
}

void enqueue(Queue* q, Node* node, int hd) {
    QNode* temp = (QNode*)malloc(sizeof(QNode));
    temp->node = node;
    temp->hd = hd;
    temp->next = NULL;

    if (q->rear == NULL) {
        q->front = q->rear = temp;
        return;
    }
    q->rear->next = temp;
    q->rear = temp;
}

QNode* dequeue(Queue* q) {
    if (q->front == NULL)
        return NULL;

    QNode* temp = q->front;
    q->front = q->front->next;

    if (q->front == NULL)
        q->rear = NULL;

    return temp;
}

Node* buildTree(int arr[], int n) {
    if (n == 0 || arr[0] == -1)
        return NULL;

    Queue* q = createQueue();
    Node* root = createNode(arr[0]);
    enqueue(q, root, 0);

    int i = 1;

    while (i < n) {
        QNode* qnode = dequeue(q);
        Node* current = qnode->node;
        free(qnode);

        if (arr[i] != -1) {
            current->left = createNode(arr[i]);
            enqueue(q, current->left, 0);
        }
        i++;

        if (i < n && arr[i] != -1) {
            current->right = createNode(arr[i]);
            enqueue(q, current->right, 0);
        }
        i++;
    }

    return root;
}

void addVertical(VNode** head, int data) {
    VNode* temp = (VNode*)malloc(sizeof(VNode));
    temp->data = data;
    temp->next = NULL;

    if (*head == NULL) {
        *head = temp;
        return;
    }

    VNode* curr = *head;
    while (curr->next)
        curr = curr->next;

    curr->next = temp;
}

void verticalOrder(Node* root) {
    if (root == NULL)
        return;

    VNode* map[2000] = {0};
    int offset = 1000;

    Queue* q = createQueue();
    enqueue(q, root, 0);

    while (q->front != NULL) {
        QNode* temp = dequeue(q);

        Node* node = temp->node;
        int hd = temp->hd;

        addVertical(&map[hd + offset], node->data);

        if (node->left)
            enqueue(q, node->left, hd - 1);

        if (node->right)
            enqueue(q, node->right, hd + 1);

        free(temp);
    }

    for (int i = 0; i < 2000; i++) {
        if (map[i]) {
            VNode* curr = map[i];
            while (curr) {
                printf("%d ", curr->data);
                curr = curr->next;
            }
            printf("\n");
        }
    }
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    Node* root = buildTree(arr, n);

    verticalOrder(root);

    return 0;
}
